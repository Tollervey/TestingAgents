<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Suppress IDE style rules that require bulk refactoring -->
    <!-- Suppress nullable warnings in test code (common with mocking frameworks) -->
    <NoWarn>$(NoWarn);IDE0011;IDE0161;IDE0065;IDE1006;xUnit1012;CS8600;CS8601;CS8602;CS8603;CS8605;CS8618;CS8620</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Api\Base\" />
    <Folder Include="Api\Integration\" />
    <Folder Include="Api\Management\" />
    <Folder Include="Api\Public\" />
    <Folder Include="Components\" />
    <Folder Include="Data\" />
    <Folder Include="Features\Tipjar\" />
    <Folder Include="Features\Realtime\" />
    <Folder Include="Features\Paywall\" />
    <Folder Include="Services\Invoice\" />
    <Folder Include="Services\Lightning\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" PublicKey="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.Bitcoin.LightningPayments.Core\Umbraco.Community.Bitcoin.LightningPayments.Core.csproj" />
  </ItemGroup>

</Project>
